generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AttachmentType {
  IMAGE
  AUDIO
  DOCUMENT
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  sentMessages Message[] @relation("SentMessages")
  sentFriendRequests FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  Chatasparticipant1 Chat[] @relation("Participant1")
  Chatasparticipant2 Chat[] @relation("Participant2")
  publicKey String?  
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  chat      Chat     @relation(fields: [chatId], references: [id])
  senderId  Int
  clientMessageId String  @unique
  sender User   @relation("SentMessages", fields: [senderId], references: [id])
  content String?  // JSON: {ciphertext, nonce, tag} when encrypted
  encryptedVersion Int?   // null = legacy plaintext, 1 = static X25519+AES-GCM
  createdAt DateTime @default(now())
  @@index([chatId, createdAt])
  attachments Attachment[]
}

model FriendRequest {
  id        Int      @id @default(autoincrement())
  senderId  Int
  sender User   @relation("SentFriendRequests", fields: [senderId], references: [id])
  receiverId Int
  receiver User   @relation("ReceivedFriendRequests", fields: [receiverId], references: [id])
  status   FriendRequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Chat {
  id        Int      @id @default(autoincrement())
  participant1Id Int
  participant1 User   @relation("Participant1", fields: [participant1Id], references: [id])
  participant2Id Int
  participant2 User   @relation("Participant2", fields: [participant2Id], references: [id])
  lastMessage String?
  lastMessageAt DateTime?
  lastMessageEncryptedVersion Int?
  createdAt DateTime @default(now())
  participant1LastReadMessageId Int?
  participant2LastReadMessageId Int?
  @@unique([participant1Id, participant2Id])
  @@index([lastMessageAt])
  messages Message[]
}

model Attachment {
  id        Int            @id @default(autoincrement())
  messageId Int
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  objectKey String         // e.g. "attachments/<uuid>.jpg" — the actual storage identity
  type      AttachmentType
  mimeType  String
  fileName  String         // original name, display-only, never used as storage identity
  fileSize  Int
  duration  Int?
  createdAt DateTime       @default(now())
}